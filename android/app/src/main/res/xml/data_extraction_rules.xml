<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="sharedpref"
            path="nfcmini_settings.xml" />
        <exclude
            domain="file"
            path="wallpapers" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="nfcmini_settings.xml" />
        <exclude
            domain="file"
            path="wallpapers" />
    </device-transfer>
</data-extraction-rules>
