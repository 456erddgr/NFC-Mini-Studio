<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用主题：无 ActionBar、透明系统栏，让壁纸铺满全屏（液态玻璃的前提） -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 对话框主题：玻璃感半透明卡片 -->
    <style name="GlassDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">86%</item>
        <item name="android:windowMinWidthMinor">86%</item>
    </style>
</resources>
